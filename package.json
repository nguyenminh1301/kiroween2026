{
  "name": "loss-of-signal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --no-error-on-unmatched-pattern src scripts && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check-budget": "node scripts/check-budget.mjs",
    "check-copy": "node scripts/check-copy.mjs",
    "e2e": "node e2e/smoke.mjs && node e2e/engine.mjs && node e2e/render.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "postprocessing": "^6.39.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^3.23.2",
    "globals": "^17.14.0",
    "playwright": "1.49.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "vite": "$vite"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
